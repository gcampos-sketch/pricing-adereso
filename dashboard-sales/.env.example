# Public Supabase settings (must refer to the same project on client and server).
SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only secrets. Never prefix these with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Private-app access token issued by HubSpot (not a Lovable connector key).
HUBSPOT_ACCESS_TOKEN=

# Optional per-user Gmail sending (server only; no passwords).
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# 32 random bytes, encoded as 64 hex characters; keep stable to decrypt connections.
GMAIL_TOKEN_ENCRYPTION_KEY=
# Canonical app origin, no trailing slash. Render uses RENDER_EXTERNAL_URL by default.
HUB_PUBLIC_ORIGIN=

# Academy: source credentials are read-only and server-only.
ACADEMY_NOTION_TOKEN=
ACADEMY_NOTION_INTEGRATION_ID=
ACADEMY_NOTION_WORKSPACE_ID=
ACADEMY_NOTION_WEBHOOK_SECRET=
# At least 32 random characters; same secret in the GitHub Actions repository settings.
ACADEMY_SYNC_SECRET=
# Enable only during the one-time Notion verification handshake, then set false.
ACADEMY_NOTION_SETUP_ENABLED=false
